// Prisma schema — Tashgheel Clinics (SaaS)
// Database: PostgreSQL
// Phase 1: Multi-tenant schema — tenantId added as NULLABLE on all tenant-scoped models.
// After data backfill (Phase 2a) succeeds, run Phase 2b to apply NOT NULL constraints via raw SQL.
// Global lookup tables (Country, BodyArea) deliberately have NO tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum TenantPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum TenantStatus {
  PENDING_VERIFICATION // After registration, before email confirmation
  ACTIVE               // Email confirmed; tenant is operational
  SUSPENDED            // Trial expired without payment, or payment failure
  CANCELLED            // Permanent closure; data retained for 30 days then purged
}

enum SubscriptionStatus {
  TRIAL     // 14-day free trial
  ACTIVE    // Paid and current
  PAST_DUE  // Payment failed; grace period (3 days)
  CANCELLED // Subscription ended
}

enum SystemRole {
  SYSTEM_ADMIN // Full platform access; bypasses tenant isolation (always audited)
  SUPPORT      // Read-only cross-tenant access
}

// ── Tenant ─────────────────────────────────────────────────────────────────
// Central registry of all clinics on the platform.
// isActive removed — TenantStatus is the single source of truth for access.

model Tenant {
  id           Int          @id @default(autoincrement())
  name         String
  slug         String       @unique  // URL-safe identifier, e.g. "cairo-clinic"
  status       TenantStatus @default(PENDING_VERIFICATION)
  contactEmail String
  logoUrl      String?
  primaryColor String?      @default("#0ea5e9")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  users                  User[]
  doctors                Doctor[]
  doctorSchedules        DoctorSchedule[]
  specialties            Specialty[]
  services               Service[]
  leadSources            LeadSource[]
  patients               Patient[]
  patientAreas           PatientArea[]
  patientImages          PatientImage[]
  patientRatings         PatientRating[]
  appointments           Appointment[]
  appointmentServices    AppointmentService[]
  payments               Payment[]
  sessionItems           SessionItem[]
  financialTransactions  FinancialTransaction[]
  vendors                Vendor[]
  products               Product[]
  stockTransactions      StockTransaction[]
  purchases              Purchase[]
  purchaseItems          PurchaseItem[]
  stockAdjustments       StockAdjustment[]
  vendorPayments         VendorPayment[]
  clinicSettings         ClinicSetting[]
  invoiceSettings        InvoiceSetting[]
  auditLogs              AuditLog[]
  subscriptions          Subscription[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("Tenants")
}

// ── Subscription ────────────────────────────────────────────────────────────
// Tracks the billing lifecycle of each tenant independently of TenantStatus.
// trialWarningSentAt: idempotency guard — prevents duplicate warning emails
//   from the hourly trial-expiration worker.

model Subscription {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  plan                TenantPlan
  status              SubscriptionStatus @default(TRIAL)
  startDate           DateTime           @default(now())
  endDate             DateTime?          // NULL = no expiry (paid plans)
  trialWarningSentAt  DateTime?          // Set when 4-day warning email is sent; prevents duplicates
  externalId          String?            // Stripe / PayMob subscription ID

  tenant              Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, endDate]) // Worker query: TRIAL + endDate <= now
  @@map("Subscriptions")
}

// ── Plan Limits ─────────────────────────────────────────────────────────────
// Seeded once. Controls feature access by plan tier.

model PlanLimit {
  plan         TenantPlan @id
  maxUsers     Int
  maxPatients  Int
  maxDoctors   Int
  storageGb    Int
  hasReports   Boolean    @default(false)
  hasStock     Boolean    @default(false)
  hasFinance   Boolean    @default(false)
  hasApi       Boolean    @default(false)

  @@map("PlanLimits")
}

// ── Email Verification ──────────────────────────────────────────────────────

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  token     String   @unique  // Cryptographically random UUID
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([token])
  @@map("EmailVerificationTokens")
}

// ── System Admin Audit Log ──────────────────────────────────────────────────
// Persistent, tamper-evident log for every cross-tenant action by System Admin.
// This table is intentionally NOT tenant-scoped (no tenantId on the model itself).
// The "tenantId" column here is the TARGET tenant being accessed, not the actor's tenant.

model SystemAdminAuditLog {
  id                Int      @id @default(autoincrement())
  systemAdminUserId Int
  tenantId          Int?     // NULL for platform-wide actions (e.g. list all tenants)
  action            String   // e.g. 'SUSPEND_TENANT', 'READ_PATIENTS', 'CREATE_TENANT'
  method            String   // HTTP method: GET, POST, PATCH, DELETE
  endpoint          String   // Full URL path: /api/superadmin/tenants/5/patients
  targetRecordId    Int?     // Specific record ID if applicable
  ipAddress         String
  userAgent         String
  timestamp         DateTime @default(now())

  systemAdmin       User     @relation("SystemAdminAuditLogs", fields: [systemAdminUserId], references: [id])

  @@index([systemAdminUserId])
  @@index([tenantId])
  @@index([timestamp(sort: Desc)])
  @@map("SystemAdminAuditLogs")
}

// ── Users ───────────────────────────────────────────────────────────────────
// tenantId is NULLABLE to support System Admin users (tenantId = NULL, systemRole = SYSTEM_ADMIN).
// Regular users always have tenantId set and systemRole = NULL.
// DB-level XOR CHECK constraint (applied in Migration 3 raw SQL):
//   (tenantId IS NOT NULL AND systemRole IS NULL)   -- regular tenant user
//   OR (tenantId IS NULL AND systemRole IS NOT NULL) -- system admin/support
// This prevents ghost users (both NULL) and conflated identities (both set).

model User {
  id           Int         @id @default(autoincrement())
  tenantId     Int?                    // NULL = System Admin — see XOR CHECK above
  systemRole   SystemRole?             // NULL = regular tenant user
  fullName     String
  email        String      @unique     // Global unique: one email = one account
  passwordHash String
  role         String      @default("Reception") // Tenant-level role
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Relations
  tenant                  Tenant?              @relation(fields: [tenantId], references: [id])
  doctor                  Doctor?
  createdPatients         Patient[]            @relation("PatientCreatedBy")
  createdAppointments     Appointment[]        @relation("AppointmentCreatedBy")
  payments                Payment[]
  uploadedImages          PatientImage[]       @relation("UploadedByUser")
  auditLogs               AuditLog[]
  financialTransactions   FinancialTransaction[]
  systemAdminAuditLogs    SystemAdminAuditLog[] @relation("SystemAdminAuditLogs")

  @@index([tenantId])
  @@map("Users")
}

// ── Doctors ─────────────────────────────────────────────────────────────────

model Doctor {
  id          Int     @id @default(autoincrement())
  tenantId    Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  userId      Int?    @unique
  fullName    String?             // Used when userId is null (external doctor)
  specialtyId Int
  commission  Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  isActive    Boolean @default(true)

  // Relations
  tenant       Tenant?         @relation(fields: [tenantId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  specialty    Specialty       @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]
  ratings      PatientRating[]
  schedules    DoctorSchedule[]

  @@index([tenantId])
  @@map("Doctors")
}

model DoctorSchedule {
  id        Int     @id @default(autoincrement())
  tenantId  Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  doctorId  Int
  dayOfWeek Int                 // 0 = Sunday … 6 = Saturday
  startTime String              // "09:00"
  endTime   String              // "17:00"
  isActive  Boolean @default(true)

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  doctor Doctor  @relation(fields: [doctorId], references: [id])

  @@index([tenantId])
  @@index([doctorId])
  @@map("DoctorSchedules")
}

// ── Specialties & Services ──────────────────────────────────────────────────

model Specialty {
  id       Int     @id @default(autoincrement())
  tenantId Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  name     String
  isActive Boolean @default(true)

  // Relations
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  doctors  Doctor[]
  services Service[]

  @@index([tenantId])
  @@map("Specialties")
}

model Service {
  id          Int     @id @default(autoincrement())
  tenantId    Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  specialtyId Int
  name        String
  price       Decimal @db.Decimal(10, 2)
  durationMin Int                 // appointment block in minutes
  isActive    Boolean @default(true)

  // Relations
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  specialty           Specialty            @relation(fields: [specialtyId], references: [id])
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  @@index([tenantId])
  @@map("Services")
}

// ── Lookup Tables ───────────────────────────────────────────────────────────
// LeadSource: per-tenant (each clinic defines its own sources)
// Country: GLOBAL — shared across all tenants, no tenantId
// BodyArea: GLOBAL — anatomical data, shared, no tenantId

model LeadSource {
  id       Int     @id @default(autoincrement())
  tenantId Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  name     String

  // Relations
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  patients Patient[]

  @@index([tenantId])
  @@map("LeadSources")
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  code String

  // Relations — no tenantId: global lookup table
  patients Patient[]

  @@map("Countries")
}

// ── Patients ─────────────────────────────────────────────────────────────────
// Patient.code uniqueness is now per-tenant (applied as compound unique in Migration 4).
// The existing @unique on code is dropped in Migration 4 and replaced with @@unique([tenantId, code]).

model Patient {
  id             Int      @id @default(autoincrement())
  tenantId       Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  code           String              // e.g. P-00001 — unique per tenant (Migration 4)
  fullName       String
  phone          String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  nationality    String?
  countryId      Int?
  leadSourceId   Int?
  medicalHistory String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  createdBy      Int?

  // Relations
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  country        Country?      @relation(fields: [countryId], references: [id])
  leadSource     LeadSource?   @relation(fields: [leadSourceId], references: [id])
  createdByUser  User?         @relation("PatientCreatedBy", fields: [createdBy], references: [id])
  appointments   Appointment[]
  areas          PatientArea[]
  images         PatientImage[]
  ratings        PatientRating[]

  @@index([tenantId])
  @@index([phone])
  // NOTE: @@unique([tenantId, code]) applied in Migration 4 after backfill
  // The existing @unique([code]) is dropped in Migration 4
  @@map("Patients")
}

// ── Body Map ────────────────────────────────────────────────────────────────
// GLOBAL: anatomical body areas shared across all tenants — no tenantId.

model BodyArea {
  id    Int    @id @default(autoincrement())
  name  String
  zone  String // 'front' | 'back'
  svgId String // maps to SVG path id

  // Relations — no tenantId
  patientAreas PatientArea[]

  @@map("BodyAreas")
}

model PatientArea {
  id        Int      @id @default(autoincrement())
  tenantId  Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  patientId Int
  areaId    Int
  notes     String?
  addedAt   DateTime @default(now())

  // Relations
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  patient Patient  @relation(fields: [patientId], references: [id])
  area    BodyArea @relation(fields: [areaId], references: [id])

  @@unique([patientId, areaId])
  @@index([tenantId])
  @@index([patientId])
  @@map("PatientAreas")
}

// ── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id           Int      @id @default(autoincrement())
  tenantId     Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  patientId    Int
  doctorId     Int
  serviceId    Int?
  startTime    DateTime
  endTime      DateTime
  status       String   @default("Pending")
  priceCharged Decimal? @db.Decimal(10, 2)
  discountPct  Decimal  @default(0) @db.Decimal(5, 2)
  notes        String?
  prescription String?
  createdAt    DateTime @default(now())
  createdBy    Int?

  // Relations
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Doctor        @relation(fields: [doctorId], references: [id])
  service       Service?      @relation(fields: [serviceId], references: [id])
  createdByUser User?         @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])
  payments      Payment[]
  images        PatientImage[]
  ratings       PatientRating[]
  sessionItems  SessionItem[]
  services      AppointmentService[]

  @@index([tenantId])
  @@index([tenantId, startTime]) // calendar queries
  @@index([doctorId, startTime])
  @@index([patientId])
  @@map("Appointments")
}

// ── Appointment Services & Procedures ───────────────────────────────────────
// Explicit procedures/services rendered during an appointment consultation.

model AppointmentService {
  id            Int      @id @default(autoincrement())
  tenantId      Int                 // Strictly tenant-scoped (NOT NULL)
  appointmentId Int
  serviceId     Int?
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([appointmentId])
  @@map("AppointmentServices")
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  appointmentId Int
  amount        Decimal  @db.Decimal(10, 2)
  method        String   @default("Cash")
  paidAt        DateTime @default(now())
  receivedBy    Int?

  // Relations
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  receivedByUser  User?       @relation(fields: [receivedBy], references: [id])

  @@index([tenantId])
  @@index([appointmentId])
  @@map("Payments")
}

// ── Patient Images ────────────────────────────────────────────────────────────
// storagePath must include tenantId prefix (e.g. "uploads/{tenantId}/{filename}")
// to prevent cross-tenant file access.

model PatientImage {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  patientId     Int
  appointmentId Int?
  imageType     String
  storagePath   String
  uploadedAt    DateTime @default(now())
  uploadedBy    Int?

  // Relations
  tenant          Tenant?      @relation(fields: [tenantId], references: [id])
  patient         Patient      @relation(fields: [patientId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  uploadedByUser  User?        @relation("UploadedByUser", fields: [uploadedBy], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@map("PatientImages")
}

// ── Ratings ───────────────────────────────────────────────────────────────────

model PatientRating {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  patientId     Int
  doctorId      Int
  appointmentId Int?
  rating        Int                 // 1–5
  notes         String?
  createdAt     DateTime @default(now())

  // Relations
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@map("PatientRatings")
}

// ── Settings ──────────────────────────────────────────────────────────────────
// Per-tenant key-value stores.
// The @id on "key" is a TEMPORARY PRIMARY KEY for Phase 1.
// Migration 4 drops it and creates a composite PK: (tenantId, key).

model ClinicSetting {
  id       Int    @id @default(autoincrement()) // temp PK; replaced in Migration 4
  tenantId Int?                                 // Phase 1: nullable; Phase 2b: NOT NULL
  key      String
  value    String

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ClinicSettings")
}

// ── Audit Log ──────────────────────────────────────────────────────────────────
// Tenant-scoped audit trail for regular operations.
// See SystemAdminAuditLog for cross-tenant System Admin actions.

model AuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  userId    Int?
  action    String
  tableName String
  recordId  Int?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@map("AuditLog")
}

// ── Stock Module ───────────────────────────────────────────────────────────────

model Vendor {
  id        Int      @id @default(autoincrement())
  tenantId  Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  tenant    Tenant?         @relation(fields: [tenantId], references: [id])
  products  Product[]
  purchases Purchase[]
  payments  VendorPayment[]

  @@index([tenantId])
  @@map("Vendors")
}

// Product.code uniqueness is now per-tenant (applied in Migration 4).
// Existing @unique([code]) is dropped in Migration 4 and replaced with
// @@unique([tenantId, code]).

model Product {
  id           Int      @id @default(autoincrement())
  tenantId     Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  name         String
  code         String              // unique per tenant — Migration 4 adds @@unique([tenantId, code])
  barcode      String?
  category     String?
  unit         String   @default("Piece")
  minStock     Decimal  @default(0) @db.Decimal(10, 2)
  currentStock Decimal  @default(0) @db.Decimal(10, 2)
  averageCost  Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice Decimal  @default(0) @db.Decimal(10, 2)
  vendorId     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  tenant        Tenant?            @relation(fields: [tenantId], references: [id])
  vendor        Vendor?            @relation(fields: [vendorId], references: [id])
  transactions  StockTransaction[]
  purchaseItems PurchaseItem[]
  sessionItems  SessionItem[]

  @@index([tenantId])
  @@map("Products")
}

model StockTransaction {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  productId     Int
  type          String              // 'Purchase' | 'Usage' | 'Adjustment' | 'Return'
  quantity      Decimal  @db.Decimal(10, 2)
  balanceBefore Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @db.Decimal(10, 2)
  cost          Decimal  @db.Decimal(10, 2)
  referenceId   Int?
  notes         String?
  userId        Int?
  createdAt     DateTime @default(now())

  // Relations
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  product Product  @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@map("StockTransactions")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  tenantId     Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  vendorId     Int
  invoiceNo    String?
  totalAmount  Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime @default(now())
  notes        String?
  attachment   String?
  status       String   @default("Completed")
  createdAt    DateTime @default(now())
  userId       Int?

  // Relations
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  vendor Vendor         @relation(fields: [vendorId], references: [id])
  items  PurchaseItem[]

  @@index([tenantId])
  @@map("Purchases")
}

model PurchaseItem {
  id                Int      @id @default(autoincrement())
  tenantId          Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  purchaseId        Int
  productId         Int
  quantity          Decimal  @db.Decimal(10, 2)
  remainingQuantity Decimal  @default(0) @db.Decimal(10, 2)
  costPerUnit       Decimal  @db.Decimal(10, 2)
  batchNo           String?
  expiryDate        DateTime?
  totalCost         Decimal  @db.Decimal(10, 2)

  // Relations
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("PurchaseItems")
}

model StockAdjustment {
  id        Int      @id @default(autoincrement())
  tenantId  Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  productId Int
  type      String              // 'Addition' | 'Shortage' | 'Wastage' | 'Damaged'
  quantity  Decimal  @db.Decimal(10, 2)
  reason    String?
  notes     String?
  userId    Int?
  createdAt DateTime @default(now())

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("StockAdjustments")
}

model VendorPayment {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  vendorId      Int
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("Cash")
  paymentDate   DateTime @default(now())
  notes         String?
  attachment    String?
  userId        Int?

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  vendor Vendor  @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@map("VendorPayments")
}

model SessionItem {
  id            Int     @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  appointmentId Int
  productId     Int
  quantity      Decimal @db.Decimal(10, 2)
  costAtTime    Decimal @db.Decimal(10, 2)
  priceAtTime   Decimal @db.Decimal(10, 2)

  // Relations
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("SessionItems")
}

// ── Finance Module ─────────────────────────────────────────────────────────────

model FinancialTransaction {
  id            Int      @id @default(autoincrement())
  tenantId      Int?                // Phase 1: nullable; Phase 2b: NOT NULL
  type          String              // 'Income' | 'Expense'
  category      String?
  amount        Decimal  @db.Decimal(10, 2)
  method        String   @default("Cash")
  description   String?
  referenceType String?             // 'Appointment' | 'Purchase' | 'Other'
  referenceId   Int?
  date          DateTime @default(now())
  attachment    String?
  userId        Int?
  createdAt     DateTime @default(now())

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date]) // finance report queries
  @@map("FinancialTransactions")
}

// ── Invoice Settings ───────────────────────────────────────────────────────────
// Per-tenant key-value store for invoice configuration.
// Same as ClinicSetting: temporary @id in Phase 1; composite PK in Migration 4.

model InvoiceSetting {
  id       Int    @id @default(autoincrement()) // temp PK; replaced in Migration 4
  tenantId Int?                                 // Phase 1: nullable; Phase 2b: NOT NULL
  key      String
  value    String

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("InvoiceSettings")
