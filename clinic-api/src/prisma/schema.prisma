// Prisma schema — Clinic Management System
// Database: PostgreSQL
// Migrated from SQL Server for Railway deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("Reception")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  doctor            Doctor?
  createdPatients   Patient[]       @relation("PatientCreatedBy")
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")
  payments          Payment[]
  uploadedImages    PatientImage[] @relation("UploadedByUser")
  auditLogs         AuditLog[]
  financialTransactions FinancialTransaction[]

  @@map("Users")
}

// ── Doctors ───────────────────────────────────────────────────────────────

model Doctor {
  id           Int     @id @default(autoincrement())
  userId       Int?    @unique
  fullName     String? // Use if userId is null
  specialtyId  Int
  commission   Decimal @default(0) @db.Decimal(5, 2)
  discount     Decimal @default(0) @db.Decimal(5, 2)
  isActive     Boolean @default(true)

  // Relations
  user         User?          @relation(fields: [userId], references: [id])
  specialty    Specialty      @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]
  ratings      PatientRating[]
  schedules    DoctorSchedule[]

  @@map("Doctors")
}

model DoctorSchedule {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)

  // Relations
  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@map("DoctorSchedules")
}

// ── Specialties & Services ────────────────────────────────────────────────

model Specialty {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)

  // Relations
  doctors  Doctor[]
  services Service[]

  @@map("Specialties")
}

model Service {
  id          Int     @id @default(autoincrement())
  specialtyId Int
  name        String
  price       Decimal @db.Decimal(10, 2)
  durationMin Int     // appointment block in minutes
  isActive    Boolean @default(true)

  // Relations
  specialty    Specialty     @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]

  @@map("Services")
}

// ── Lookup tables ─────────────────────────────────────────────────────────

model LeadSource {
  id   Int    @id @default(autoincrement())
  name String

  // Relations
  patients Patient[]

  @@map("LeadSources")
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  code String

  // Relations
  patients Patient[]

  @@map("Countries")
}

// ── Patients ──────────────────────────────────────────────────────────────

model Patient {
  id             Int         @id @default(autoincrement())
  code           String      @unique // P-00001
  fullName       String
  phone          String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  nationality    String?
  countryId      Int?
  leadSourceId   Int?
  medicalHistory String?
  notes          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  createdBy      Int?

  // Relations
  country      Country?      @relation(fields: [countryId], references: [id])
  leadSource   LeadSource?   @relation(fields: [leadSourceId], references: [id])
  createdByUser User?        @relation("PatientCreatedBy", fields: [createdBy], references: [id])
  appointments Appointment[]
  areas        PatientArea[]
  images       PatientImage[]
  ratings      PatientRating[]

  @@index([phone])
  @@index([code])
  @@map("Patients")
}

// ── Body Map ──────────────────────────────────────────────────────────────

model BodyArea {
  id    Int    @id @default(autoincrement())
  name  String
  zone  String // 'front' | 'back'
  svgId String // maps to SVG path id

  // Relations
  patientAreas PatientArea[]

  @@map("BodyAreas")
}

model PatientArea {
  id        Int      @id @default(autoincrement())
  patientId Int
  areaId    Int
  notes     String?
  addedAt   DateTime @default(now())

  // Relations
  patient Patient  @relation(fields: [patientId], references: [id])
  area    BodyArea @relation(fields: [areaId], references: [id])

  @@unique([patientId, areaId])
  @@index([patientId])
  @@map("PatientAreas")
}

// ── Appointments ──────────────────────────────────────────────────────────

model Appointment {
  id           Int               @id @default(autoincrement())
  patientId    Int
  doctorId     Int
  serviceId    Int
  startTime    DateTime
  endTime      DateTime
  status       String   @default("Pending")
  priceCharged Decimal?          @db.Decimal(10, 2)
  discountPct  Decimal           @default(0) @db.Decimal(5, 2)
  notes        String?
  prescription String?
  createdAt    DateTime          @default(now())
  createdBy    Int?

  // Relations
  patient       Patient         @relation(fields: [patientId], references: [id])
  doctor        Doctor          @relation(fields: [doctorId], references: [id])
  service       Service         @relation(fields: [serviceId], references: [id])
  createdByUser User?           @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])
  payments      Payment[]
  images        PatientImage[]
  ratings       PatientRating[]
  sessionItems  SessionItem[]

  @@index([doctorId, startTime])
  @@index([patientId])
  @@index([startTime])
  @@map("Appointments")
}

// ── Payments ──────────────────────────────────────────────────────────────

model Payment {
  id            Int           @id @default(autoincrement())
  appointmentId Int
  amount        Decimal       @db.Decimal(10, 2)
  method        String   @default("Cash")
  paidAt        DateTime      @default(now())
  receivedBy    Int?

  // Relations
  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  receivedByUser User?    @relation(fields: [receivedBy], references: [id])

  @@index([appointmentId])
  @@map("Payments")
}

// ── Patient Images ────────────────────────────────────────────────────────

model PatientImage {
  id            Int       @id @default(autoincrement())
  patientId     Int
  appointmentId Int?
  imageType     String
  storagePath   String
  uploadedAt    DateTime  @default(now())
  uploadedBy    Int?

  // Relations
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  uploadedByUser User?       @relation("UploadedByUser", fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@map("PatientImages")
}

// ── Ratings ───────────────────────────────────────────────────────────────

model PatientRating {
  id            Int      @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  appointmentId Int?
  rating        Int      // 1–5
  notes         String?
  createdAt     DateTime @default(now())

  // Relations
  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("PatientRatings")
}

// ── Settings ──────────────────────────────────────────────────────────────

model ClinicSetting {
  key   String @id
  value String

  @@map("ClinicSettings")
}

// ── Audit Log ─────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  tableName String
  recordId  Int?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("AuditLog")
}

// ── Stock Module (Inventory) ──────────────────────────────────────────────

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  products  Product[]
  purchases Purchase[]
  payments  VendorPayment[]

  @@map("Vendors")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  barcode      String?
  category     String?
  unit         String   @default("Piece") // Box, ML, Gram, Piece
  minStock     Int      @default(0)
  currentStock Int      @default(0)
  averageCost  Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice Decimal  @default(0) @db.Decimal(10, 2)
  vendorId     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  vendor       Vendor?            @relation(fields: [vendorId], references: [id])
  transactions StockTransaction[]
  purchaseItems PurchaseItem[]
  sessionItems SessionItem[]

  @@map("Products")
}

model StockTransaction {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        String   // 'Purchase', 'Usage', 'Adjustment', 'Return'
  quantity    Int      // Positive for IN, Negative for OUT
  balanceBefore Int
  balanceAfter  Int
  cost        Decimal  @db.Decimal(10, 2)
  referenceId Int?     // ID of Purchase, Session, or Adjustment
  notes       String?
  userId      Int?
  createdAt   DateTime @default(now())

  // Relations
  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("StockTransactions")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  vendorId     Int
  invoiceNo    String?
  totalAmount  Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime @default(now())
  notes        String?
  attachment   String?
  status       String   @default("Completed")
  createdAt    DateTime @default(now())
  userId       Int?

  // Relations
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  items        PurchaseItem[]

  @@map("Purchases")
}

model PurchaseItem {
  id           Int      @id @default(autoincrement())
  purchaseId   Int
  productId    Int
  quantity     Int
  remainingQuantity Int      @default(0)
  costPerUnit  Decimal  @db.Decimal(10, 2)
  batchNo      String?
  expiryDate   DateTime?
  totalCost    Decimal  @db.Decimal(10, 2)

  // Relations
  purchase     Purchase @relation(fields: [purchaseId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@map("PurchaseItems")
}

model StockAdjustment {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        String   // 'Addition', 'Shortage', 'Wastage', 'Damaged'
  quantity    Int      // The net change
  reason      String?
  notes       String?
  userId      Int?
  createdAt   DateTime @default(now())

  @@map("StockAdjustments")
}

model VendorPayment {
  id            Int      @id @default(autoincrement())
  vendorId      Int
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("Cash")
  paymentDate   DateTime @default(now())
  notes         String?
  attachment    String?
  userId        Int?

  // Relations
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  @@map("VendorPayments")
}

model SessionItem {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  productId     Int
  quantity      Int
  costAtTime    Decimal  @db.Decimal(10, 2)
  priceAtTime   Decimal  @db.Decimal(10, 2)

  // Relations
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@map("SessionItems")
}

model FinancialTransaction {
  id            Int      @id @default(autoincrement())
  type          String   // 'Income', 'Expense'
  category      String?  // 'Rent', 'Salary', 'Medical Supplies', etc.
  amount        Decimal  @db.Decimal(10, 2)
  method        String   @default("Cash") // Cash, Card, Vodafone Cash, Bank Transfer, Insurance
  description   String?
  referenceType String?  // 'Appointment', 'Purchase', 'Other'
  referenceId   Int?
  date          DateTime @default(now())
  attachment    String?
  userId        Int?
  createdAt     DateTime @default(now())

  // Relations
  user          User?    @relation(fields: [userId], references: [id])

  @@map("FinancialTransactions")
}

model InvoiceSetting {
  key   String @id
  value String

  @@map("InvoiceSettings")
}

