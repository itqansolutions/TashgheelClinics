# Server
NODE_ENV=development
PORT=4000

# Database — SQL Server connection string for Prisma
DATABASE_URL="sqlserver://localhost:1433;database=ClinicDB;user=sa;password=YourPassword123!;encrypt=true;trustServerCertificate=true"

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-too-separate-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# File Storage — use 'local' for dev, 's3' for production
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# AWS S3 (production)
AWS_REGION=us-east-1
AWS_BUCKET=clinic-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clinic System <no-reply@clinic.com>"
